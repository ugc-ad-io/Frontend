# Copy to .env.backend and fill in.  ->  cp .env.backend.example .env.backend
# Runtime secrets for the FastAPI container. Passed via compose `env_file`, so
# they are NEVER baked into the image and never reach the build context
# (.dockerignore excludes .env from the backend build).
#
# Keys below are the ones server.py / storage.py actually read.

# ── Database (required) ──────────────────────────────────────────────────────
# MongoDB connection string. Atlas or a self-hosted instance.
# NOTE: if you run Mongo in this same compose stack later, the host is the
# service name, not localhost — localhost inside a container is the container.
MONGO_URL=
DB_NAME=

# ── Auth (required) ──────────────────────────────────────────────────────────
# Long random string. Rotating it invalidates every issued token.
JWT_SECRET=
GOOGLE_CLIENT_ID=

# ── URLs ─────────────────────────────────────────────────────────────────────
# Used for links in outbound email and for redirects.
FRONTEND_URL=

# CORS_ORIGINS is only needed if the frontend is served from a DIFFERENT origin.
# With the Caddy setup here everything is same-origin, so it can stay empty.
CORS_ORIGINS=

# ── File storage ─────────────────────────────────────────────────────────────
# storage.py routes uploads to Cloudinary when configured, and falls back to the
# local disk (the backend-uploads volume) when it isn't. Strongly prefer
# Cloudinary in production: the fallback is a single container's disk, so it
# does not survive moving the container to another host and is not CDN-backed.
# Either one variable:
CLOUDINARY_URL=
# ...or the three separately:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Flags ────────────────────────────────────────────────────────────────────
ENFORCE_BANS=true
