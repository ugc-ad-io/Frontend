# Copy to .env and fill in.  ->  cp .env.example .env
# This file is for COMPOSE ITSELF (build args + proxy). Backend runtime secrets
# live separately in .env.backend — see .env.backend.example.

# ── Where the two repos are checked out ──────────────────────────────────────
# Defaults assume they sit side by side and compose runs from Frontend/deploy:
#   /srv/Frontend  and  /srv/Backend
FRONTEND_PATH=..
BACKEND_PATH=../../Backend

# ── Public address ───────────────────────────────────────────────────────────
# A bare domain turns on automatic HTTPS (Let's Encrypt) — point the DNS A
# record at this server FIRST, or certificate issuance will fail.
#   SITE_ADDRESS=app.ugcad.io
# Use :80 for plain HTTP (local testing, or behind another TLS terminator).
SITE_ADDRESS=:80

# ── Frontend build args (BAKED IN AT BUILD TIME) ─────────────────────────────
# Leave REACT_APP_BACKEND_URL EMPTY when using this stack: Caddy serves the API
# on the same origin under /api, so relative calls work and there is no CORS.
# Only set it if the backend is on a different domain.
REACT_APP_BACKEND_URL=
REACT_APP_GOOGLE_CLIENT_ID=
